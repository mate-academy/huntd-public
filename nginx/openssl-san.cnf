[req]
default_bits        = 2048
default_keyfile     = privkey.pem
default_md          = sha256
distinguished_name  = req_distinguished_name
req_extensions      = v3_req

[req_distinguished_name]
C = UA
ST = Kyiv oblast
L = Kyiv
O = Mate academy
OU = Engineering team
CN = local.huntd.tech

[v3_req]
subjectAltName = @alt_names

[alt_names]
DNS.1 = local.huntd.tech

